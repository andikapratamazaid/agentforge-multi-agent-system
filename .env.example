# Salin file ini menjadi .env atau ekspor variabelnya di shell.
# Tanpa OPENROUTER_API_KEY, AgentForge berjalan dalam mode demo
# deterministik (tanpa panggilan jaringan dan tanpa biaya).

# API key OpenRouter untuk mode live. Dapatkan di openrouter.ai.
OPENROUTER_API_KEY=

# Opsional: timpa model utama satu agent tanpa mengubah config/models.json.
# AGENTFORGE_MODEL_WRITER=anthropic/claude-3.5-sonnet
# AGENTFORGE_MODEL_REVIEWER=openai/gpt-4o
# AGENTFORGE_MODEL_CONDUCTOR=openai/gpt-4o-mini
# AGENTFORGE_MODEL_RESEARCH=google/gemini-flash-1.5
# AGENTFORGE_MODEL_DATA=openai/gpt-4o-mini
